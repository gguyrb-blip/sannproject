# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key — SERVER ONLY. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public site URL (used for absolute URLs in metadata/SEO)
NEXT_PUBLIC_SITE_URL=https://sannstay.com

# Email notifications via Resend (optional but recommended).
# Sign up at https://resend.com (free tier: 100 emails/day).
# If RESEND_API_KEY is unset the form submissions still save to
# Supabase — only the email side-channel is skipped.
RESEND_API_KEY=
NOTIFICATION_EMAIL=sannascent.co@gmail.com
# Optional. Defaults to "Sann Stay <onboarding@resend.dev>" which works
# without any domain verification on the Resend free tier.
EMAIL_FROM=

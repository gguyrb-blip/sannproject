# Supabase (public — safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Service role key — SERVER ONLY. Never expose to the browser.
# Only used inside src/lib/supabase/admin.ts (server-only) for moderation
# bypass when reading from RLS-protected tables in the admin dashboard or
# for fully-trusted server writes.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public site URL (used for absolute URLs in metadata/SEO)
NEXT_PUBLIC_SITE_URL=https://sannstay.com
